ADMIN_PASSWORD=change-me

# ElevenLabs conversational AI (Wave AI widget)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Public site URL (canonical + Open Graph)
NEXT_PUBLIC_SITE_URL=https://frequency-wave-nine.vercel.app
