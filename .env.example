# Postgres connection string
DATABASE_URL=postgres://user@localhost:5432/frequency_wave
# Secret used to sign admin session cookies (openssl rand -hex 32)
AUTH_SECRET=change-me
# Admin dashboard credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ElevenLabs conversational AI (Wave AI widget)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Public site URL (canonical + Open Graph)
NEXT_PUBLIC_SITE_URL=https://frequencywave.dev

# Welcome email for newsletter subscribers (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Frequency Wave <hello@your-verified-domain.com>
# Contact form recipient
CONTACT_TO_EMAIL=frequencywave101@gmail.com
